# ==========================================
# 必填配置项示例 (Required Configuration)
# ==========================================

# 1. 认证与安全配置 (Security)
# 用于生成和验证 JWT Token 的密钥，生产环境中请务必生成并使用高强度的随机字符串。
# 不能使用默认值或弱口令，否则后端将拒绝启动。
JWT_SECRET_KEY=your-strong-jwt-secret-key-here

# 2. 数据库连接配置 (Database)
# 用于连接 PostgreSQL 数据库。必须提供有效的连接字符串。
# 示例: postgresql://username:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:pass@localhost:5432/deepresvalue

# 3. 火山引擎服务配置 (Volcengine Services)
# 火山引擎 API 访问凭证
VOLCENGINE_ACCESS_KEY=your_volcengine_access_key_here
VOLCENGINE_SECRET_KEY=your_volcengine_secret_key_here

# 火山引擎对象存储 (TOS) 存储桶名称
VOLCENGINE_TOS_BUCKET=your_tos_bucket_name

# ==========================================
# 可选配置项示例 (Optional Configuration)
# ==========================================

# 模型 API 密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
