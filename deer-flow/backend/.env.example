DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/deerflow
AUTH_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/auth
DEEPSEEK_API_KEY=your_deepseek_api_key_here
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# Volcengine TOS Configuration
VOLCENGINE_TOS_ENDPOINT=your_tos_endpoint
VOLCENGINE_TOS_REGION=your_tos_region
VOLCENGINE_TOS_BUCKET=your_tos_bucket
VOLCENGINE_ACCESS_KEY_ID=your_access_key_id
VOLCENGINE_ACCESS_KEY_SECRET=your_access_key_secret

# Volcengine veFaaS Sandbox Configuration
VOLCENGINE_ACCESS_KEY=your_vefaas_access_key
VOLCENGINE_SECRET_KEY=your_vefaas_secret_key
VEFAAS_FUNCTION_ID=your_vefaas_function_id

# Redis Configuration (for Session Management)
REDIS_URL=redis://localhost:6379/0
