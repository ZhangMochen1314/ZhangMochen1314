# 阿里云沙箱与服务
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION=cn-hangzhou

# 阿里云 OSS
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 数据库（阿里云 RDS）
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/deeptrace

# Redis
REDIS_HOST=
REDIS_PORT=6379

# 安全
JWT_SECRET_KEY=  # 生成命令: python -c "import secrets; print(secrets.token_urlsafe(64))"

# 数据库 (本地开发可使用 SQLite)
DATABASE_URL="sqlite:///deerflow.db"

# ===== 阿里云 OSS 配置 =====
ALIYUN_OSS_ACCESS_KEY_ID="your_oss_access_key_id"
ALIYUN_OSS_ACCESS_KEY_SECRET="your_oss_access_key_secret"
ALIYUN_OSS_BUCKET="deeptrace-data-hz"
ALIYUN_OSS_ENDPOINT="oss-cn-hangzhou-internal.aliyuncs.com"
ALIYUN_OSS_REGION="cn-hangzhou"

# ===== 大语言模型 API 密钥 =====
# 阿里云百炼 API Key (主模型，支持联网搜索)
DASHSCOPE_API_KEY="your_dashscope_api_key"
ALIYUN_BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# DeepSeek 官方 API Key (备用模型)
DEEPSEEK_API_KEY="your_deepseek_api_key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# ===== 阿里云 FC 配置 =====
ALIYUN_FC_REGION="cn-hangzhou"
ALIYUN_FC_ACCOUNT_ID="your_aliyun_account_id"
